DETECTION_CONFIDENCE=0.35
VIDEO_FRAME_SAMPLE_SECONDS=1.0
MAX_VIDEO_SAMPLE_FRAMES=180
# Optional: absolute path or repo-relative path to your trained YOLO weights
MODEL_PATH=model/runs/train/weapon_detector2/weights/best.pt

# Gmail example. Use an App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
ALERT_FROM_EMAIL=your-email@gmail.com
ALERT_TO_EMAIL=receiver@example.com
ALERT_SUBJECT_PREFIX=AI Ranger Alert
